<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
    <add key="Jint-preview" value="https://f.feedz.io/sebastienros/jint/nuget/index.json" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="Jint-preview"><package pattern="Jint" /></packageSource>
    <packageSource key="nuget.org"><package pattern="*" /></packageSource>
  </packageSourceMapping>
</configuration>
