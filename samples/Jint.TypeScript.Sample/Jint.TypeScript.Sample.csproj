<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <IsPackable>false</IsPackable>
    <DefaultItemExcludes>$(DefaultItemExcludes);ClientApp/node_modules/**</DefaultItemExcludes>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../src/Jint.TypeScript/Jint.TypeScript.csproj" />
    <None Update="Scripts/**/*.ts;Inputs/*.json" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
  <Target Name="BuildPlayground" BeforeTargets="PrepareForBuild" Condition="'$(DesignTimeBuild)' != 'true' and '$(SkipPlaygroundBuild)' != 'true'">
    <MSBuild Projects="ClientApp/Client.proj" Targets="Build" RemoveProperties="TargetFramework;TargetFrameworks;RuntimeIdentifier;SelfContained" />
  </Target>
  <ItemGroup>
    <Content Remove="ClientApp/**" />
    <None Remove="ClientApp/node_modules/**" />
  </ItemGroup>
  <Target Name="IncludePlaygroundAssets" BeforeTargets="ResolveProjectStaticWebAssets;AssignTargetPaths" DependsOnTargets="BuildPlayground">
    <ItemGroup>
      <_PreviousPlaygroundAssets Include="@(Content)" Condition="$([System.String]::Copy('%(Content.Identity)').Replace('\','/').StartsWith('wwwroot/'))" />
      <Content Remove="@(_PreviousPlaygroundAssets)" />
      <Content Include="wwwroot/**/*" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    </ItemGroup>
  </Target>
</Project>
